# Секрет для подписи сессионных cookie. Обязательно замените на случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Путь к базе данных SQLite ------------------------------------------------
DATABASE_PATH=./data.db

# --- Режим отладки (true только локально) -------------------------------------
FLASK_DEBUG=false

# --- Сессии -------------------------------------------------------------------
# SESSION_COOKIE_SECURE=true — включить, если сайт работает по HTTPS
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_DAYS=7

# --- Первый администратор -----------------------------------------------------
# Если заданы логин и пароль, аккаунт руководителя создаётся автоматически
# при первом запуске. Если не заданы — создайте его на странице /login
# (кнопка «Создать первого администратора»).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# --- Тестовые данные ----------------------------------------------------------
# true — загрузить 2 пользователей и 3 проекта из db/schema.sql
# (admin/admin123 и user/user123). Для продакшена оставьте false.
SEED_DATA=false

# --- Сеть ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
